{"nodes": [{"id": "graphify_out_tex_implementation_plan_tex_bd_citizenlink", "label": "BD-Citizenlink Citizen Registry Prototype", "file_type": "concept", "source_file": "graphify-out/tex/Implementation_Plan.tex.md", "source_location": "Section: Project Overview", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Prototype built to show that a graph database can model and query complex Bangladeshi family relationships across millions of records with sub-second response times."}, {"id": "graphify_out_tex_implementation_plan_tex_nid_data_create", "label": "Nid_data_create.py Data Generator", "file_type": "concept", "source_file": "graphify-out/tex/Implementation_Plan.tex.md", "source_location": "Section: Data Generation Module", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "graphify_out_tex_implementation_plan_tex_neo4j_import", "label": "neo4j_import.py Two-Pass Importer", "file_type": "concept", "source_file": "graphify-out/tex/Implementation_Plan.tex.md", "source_location": "Section: Import Process", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "graphify_out_tex_implementation_plan_tex_app_py", "label": "app.py Flask REST API Server", "file_type": "concept", "source_file": "graphify-out/tex/Implementation_Plan.tex.md", "source_location": "Section: Backend API", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "graphify_out_tex_implementation_plan_tex_validate_data", "label": "validate_data.py Consistency Checker", "file_type": "concept", "source_file": "graphify-out/tex/Implementation_Plan.tex.md", "source_location": "Section: Internal Consistency Checks", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Realistic rules mean little if the generator silently breaks them, so the second half of the realism argument is measured (13 read-only Cypher checks) rather than merely asserted."}, {"id": "graphify_out_tex_implementation_plan_tex_inject_multiple_marriages", "label": "inject_multiple_marriages.py Polygamy Injection Utility", "file_type": "concept", "source_file": "graphify-out/tex/Implementation_Plan.tex.md", "source_location": "Section: Polygamy Injection Utility", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The full CSV is over 1 GB and a fresh regeneration changes every NID, so polygamous households are injected into the existing dataset and exported as a small polygamy_delta.csv for delta import instead of regenerating."}, {"id": "graphify_out_tex_implementation_plan_tex_system_rules", "label": "47 System Rules", "file_type": "rationale", "source_file": "graphify-out/tex/Implementation_Plan.tex.md", "source_location": "Section: System Rules", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Rules 1-33 govern generation, 34-45 govern relationship reading and input validation, 46-47 came with the multiple-marriage upgrade. Almost every rule mirrors a real Bangladesh fact (legal marriage ages 21/18, 2022 census religion mix, falling fertility) so the synthetic population is defensible."}, {"id": "graphify_out_tex_implementation_plan_tex_polygyny_rules", "label": "Rules 46-47 Polygyny Model", "file_type": "rationale", "source_file": "graphify-out/tex/Implementation_Plan.tex.md", "source_location": "Subsection: Multiple Marriage Rules", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Only married Muslim men may take up to four wives (2 wives 8%, 3 wives 3%, 4 wives 1%, ~12% overall); all other religions are strictly monogamous. Rates are deliberately generous versus real prevalence so the feature shows up clearly in demos."}, {"id": "graphify_out_tex_implementation_plan_tex_pipe_separated_spouse_nid", "label": "Pipe-Separated spouse_nid Encoding", "file_type": "rationale", "source_file": "graphify-out/tex/Implementation_Plan.tex.md", "source_location": "Rule 47", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Multiple spouses live in a single CSV column separated by '|' because NIDs are pure digits, so the separator can never collide with a value; each wife stores only her husband's NID, keeping the schema single-column."}, {"id": "graphify_out_tex_implementation_plan_tex_citizen_node_label", "label": ":Citizen Node Label and Properties", "file_type": "concept", "source_file": "graphify-out/tex/Implementation_Plan.tex.md", "source_location": "Section: Graph Schema", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "graphify_out_tex_implementation_plan_tex_married_to", "label": "MARRIED_TO Relationship", "file_type": "concept", "source_file": "graphify-out/tex/Implementation_Plan.tex.md", "source_location": "Subsection: Relationship Types", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Undirected marriage link; a polygynous man can carry up to four of these edges."}, {"id": "graphify_out_tex_implementation_plan_tex_has_father", "label": "HAS_FATHER Relationship", "file_type": "concept", "source_file": "graphify-out/tex/Implementation_Plan.tex.md", "source_location": "Subsection: Relationship Types", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "graphify_out_tex_implementation_plan_tex_has_mother", "label": "HAS_MOTHER Relationship", "file_type": "concept", "source_file": "graphify-out/tex/Implementation_Plan.tex.md", "source_location": "Subsection: Relationship Types", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "graphify_out_tex_implementation_plan_tex_nid_uniqueness_constraint", "label": "nid Uniqueness Constraint and B-Tree Index", "file_type": "concept", "source_file": "graphify-out/tex/Implementation_Plan.tex.md", "source_location": "Subsection: Constraints and Indexes", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The uniqueness constraint on Citizen.nid also creates a B-Tree index for free, giving O(log n) lookups even at 5 million records."}, {"id": "graphify_out_tex_implementation_plan_tex_two_pass_import", "label": "Two-Pass Batch Import", "file_type": "rationale", "source_file": "graphify-out/tex/Implementation_Plan.tex.md", "source_location": "Section: Import Process", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Pass 1 MERGEs every Citizen node, pass 2 creates relationships, so an edge is only created when both endpoints already exist (Rule 44). Batches of 10,000 rows through UNWIND avoid the cost of one transaction per row, and MERGE over CREATE makes re-import idempotent."}, {"id": "graphify_out_tex_implementation_plan_tex_ordering_guard", "label": "nid < sp_nid Ordering Guard", "file_type": "rationale", "source_file": "graphify-out/tex/Implementation_Plan.tex.md", "source_location": "Subsection: Pass 2 Relationship Creation", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Because marriage is stored on both sides, the lexicographic guard makes each MARRIED_TO edge get created exactly once even when one row lists several spouses."}, {"id": "graphify_out_tex_implementation_plan_tex_generate_nid", "label": "generate_nid NID Generation Algorithm", "file_type": "concept", "source_file": "graphify-out/tex/Implementation_Plan.tex.md", "source_location": "Subsection: NID Generation Algorithm", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "13-digit NID = 4-digit birth year + 2-digit district code + 7 random digits, retried against a used-NID set so no two citizens collide (Rules 29, 31)."}, {"id": "graphify_out_tex_implementation_plan_tex_csv_output_schema", "label": "CSV Output Schema", "file_type": "concept", "source_file": "graphify-out/tex/Implementation_Plan.tex.md", "source_location": "Subsection: CSV Output Schema", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "graphify_out_tex_implementation_plan_tex_family_tree_api", "label": "/api/family-tree Endpoint", "file_type": "concept", "source_file": "graphify-out/tex/Implementation_Plan.tex.md", "source_location": "Subsection: Family Tree API - Detailed Logic", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Runs a fixed 12-step sequence (root, ancestors, descendants, spouses, siblings, nephews, uncles, cousins, restricted marriage expansion, parent back-fill, edge de-duplication, labeling) so cost stays flat regardless of family size."}, {"id": "graphify_out_tex_implementation_plan_tex_relationship_api", "label": "/api/relationship Endpoint", "file_type": "concept", "source_file": "graphify-out/tex/Implementation_Plan.tex.md", "source_location": "Subsection: API Endpoints", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "graphify_out_tex_implementation_plan_tex_inheritors_api", "label": "/api/inheritors Endpoint", "file_type": "concept", "source_file": "graphify-out/tex/Implementation_Plan.tex.md", "source_location": "Subsection: Inheritors Endpoint", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "graphify_out_tex_implementation_plan_tex_birth_audit_api", "label": "/api/birth-audit Endpoint", "file_type": "concept", "source_file": "graphify-out/tex/Implementation_Plan.tex.md", "source_location": "Subsection: Birth Registration Audit Endpoint", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "graphify_out_tex_implementation_plan_tex_search_api", "label": "/api/search Endpoint", "file_type": "concept", "source_file": "graphify-out/tex/Implementation_Plan.tex.md", "source_location": "Subsection: Search Optimization", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "All-digit queries take the STARTS WITH fast path on the B-Tree index; anything else falls back to a CONTAINS scan. Most searches are NID searches, so most hit the fast path."}, {"id": "graphify_out_tex_implementation_plan_tex_relationship_classification", "label": "Relationship Classification Algorithm", "file_type": "rationale", "source_file": "graphify-out/tex/Implementation_Plan.tex.md", "source_location": "Subsection: Relationship Classification Algorithm", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Walks the shortest path and reads the sequence of UP/DOWN/SPOUSE moves. Order-sensitive multiple-marriage patterns are checked before count-based rules because move counts alone cannot tell a father's second wife from a wife's mother - both are one parent hop plus one marriage hop."}, {"id": "graphify_out_tex_implementation_plan_tex_order_sensitive_labels", "label": "Order-Sensitive Multiple-Marriage Labels", "file_type": "rationale", "source_file": "graphify-out/tex/Implementation_Plan.tex.md", "source_location": "Table: Order-sensitive multiple-marriage labels", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "SPOUSE+SPOUSE = co-wife, UP+SPOUSE = step-parent, SPOUSE+DOWN = step-child, UP+DOWN with exactly one shared parent = half-sibling."}, {"id": "graphify_out_tex_implementation_plan_tex_count_based_labels", "label": "Count-Based Path Classification Table", "file_type": "rationale", "source_file": "graphify-out/tex/Implementation_Plan.tex.md", "source_location": "Table: Relationship classification based on path direction counts", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "graphify_out_tex_implementation_plan_tex_parents_map", "label": "Parents Map", "file_type": "concept", "source_file": "graphify-out/tex/Implementation_Plan.tex.md", "source_location": "Subsection: Relationship Classification Algorithm", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A {nid: {father, mother}} map for everyone on the path; without it the classifier cannot separate full from half siblings, or step-parents from in-laws."}, {"id": "graphify_out_tex_implementation_plan_tex_relationship_detail", "label": "_relationship_detail Detail Line", "file_type": "concept", "source_file": "graphify-out/tex/Implementation_Plan.tex.md", "source_location": "Subsection: Relationship Classification Algorithm", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Returns a short explanation shown next to the label ('same father', 'shares husband Karim Ahmed') so the label carries its own proof."}, {"id": "graphify_out_tex_implementation_plan_tex_compute_all_relationships", "label": "_compute_all_relationships BFS Labeling", "file_type": "concept", "source_file": "graphify-out/tex/Implementation_Plan.tex.md", "source_location": "Subsection: BFS-Based Relationship Labeling", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Builds a direction-annotated adjacency list, BFS from the root for shortest paths, then labels each node via _label_from_path in O(V+E)."}, {"id": "graphify_out_tex_implementation_plan_tex_fetch_parents", "label": "_fetch_parents Parent Back-Fill", "file_type": "concept", "source_file": "graphify-out/tex/Implementation_Plan.tex.md", "source_location": "Family Tree API step 10", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Fills in missing parent edges between people already on the canvas. Without it, all children of a polygynous man would hang off the father alone instead of splitting into one branch per wife."}, {"id": "graphify_out_tex_implementation_plan_tex_shortest_path_query", "label": "shortestPath Cypher Relationship Query", "file_type": "concept", "source_file": "graphify-out/tex/Implementation_Plan.tex.md", "source_location": "Subsection: Shortest Path Relationship Finding", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Neo4j shortestPath over HAS_FATHER|HAS_MOTHER|MARRIED_TO capped at 20 hops to keep the query cheap."}, {"id": "graphify_out_tex_implementation_plan_tex_min_birth_gap", "label": "MIN_BIRTH_GAP_DAYS 270-Day Rule", "file_type": "rationale", "source_file": "graphify-out/tex/Implementation_Plan.tex.md", "source_location": "Subsection: Birth Gap Audit", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "270 days is roughly a full-term pregnancy: a 0-day gap is twins and allowed, 0<delta<270 is biologically impossible for one mother and gets flagged, and 270 or more is normal."}, {"id": "graphify_out_tex_implementation_plan_tex_graph_vs_table_split", "label": "Graph vs Table Deliberate Split", "file_type": "rationale", "source_file": "graphify-out/tex/Implementation_Plan.tex.md", "source_location": "Subsection: Graph vs. Table - A Deliberate Split", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The API computes every relative, but the canvas shows only close family to stay readable while the View Table shows everything categorized onto the father's or mother's side."}, {"id": "graphify_out_tex_implementation_plan_tex_graph_hide", "label": "GRAPH_HIDE Role Regex", "file_type": "concept", "source_file": "graphify-out/tex/Implementation_Plan.tex.md", "source_location": "Subsection: Graph vs. Table", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "graphify_out_tex_implementation_plan_tex_no_in_laws", "label": "No-In-Laws Invariant", "file_type": "rationale", "source_file": "graphify-out/tex/Implementation_Plan.tex.md", "source_location": "Family Tree API step 9", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Enforced during data gathering rather than by hiding labels: marriages are expanded only for the root's own spouses and direct parents, so a sibling's spouse or grandparent's second spouse is never fetched at all."}, {"id": "graphify_out_tex_implementation_plan_tex_visual_encoding", "label": "Graph Canvas Visual Encoding", "file_type": "concept", "source_file": "graphify-out/tex/Implementation_Plan.tex.md", "source_location": "Subsection: Graph Canvas - Visual Encoding", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every color, ring and line style has a fixed meaning (blue father link, pink mother link, gold curved dash-dot marriage, cyan dashed half-sibling ring, rose co-wife ring, marriage-count badge) so polygynous and step relations are spottable at a glance."}, {"id": "graphify_out_tex_implementation_plan_tex_force_simulation", "label": "D3 Force Simulation and BIG_TREE Tuning", "file_type": "concept", "source_file": "graphify-out/tex/Implementation_Plan.tex.md", "source_location": "Subsection: Force Simulation Parameters", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Trees over 150 nodes switch to cheaper settings (charge -300, distanceMax 420, collision 26, alphaDecay 0.05) so a 300+ node founder tree settles instead of stalling the page."}, {"id": "graphify_out_tex_implementation_plan_tex_simulation_lifecycle", "label": "Simulation Stop-Before-Rerender Lifecycle", "file_type": "rationale", "source_file": "graphify-out/tex/Implementation_Plan.tex.md", "source_location": "Section: Performance Considerations", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every re-render calls simulation.stop() on the previous simulation; otherwise old simulations pile up on removed nodes, choke the main thread and freeze zoom and pan."}, {"id": "graphify_out_tex_implementation_plan_tex_categorize_side", "label": "categorizeSide Side Categorization", "file_type": "concept", "source_file": "graphify-out/tex/Implementation_Plan.tex.md", "source_location": "Subsection: Side Categorization (Relationship Table)", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Traces ancestors to place a relative on the father's or mother's side; cousins need an extra grandparent hop, otherwise a maternal cousin is wrongly routed to the father's side through the root."}, {"id": "graphify_out_tex_implementation_plan_tex_localhost_ipv6_stall", "label": "127.0.0.1 vs localhost IPv6 Stall", "file_type": "rationale", "source_file": "graphify-out/tex/Implementation_Plan.tex.md", "source_location": "Section: Performance Considerations", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "On Windows localhost resolves to ::1 first while the Flask dev server listens on IPv4 only, so every request waits ~2s for the IPv6 attempt to fail. The app felt slow even though the family-tree API answers in ~20ms warm; opening 127.0.0.1:5000 removes the delay entirely."}, {"id": "graphify_out_tex_implementation_plan_tex_districts_json", "label": "districts.json Geographic Reference", "file_type": "concept", "source_file": "graphify-out/tex/Implementation_Plan.tex.md", "source_location": "Section: Data Files", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "graphify_out_tex_implementation_plan_tex_names_json", "label": "names.json Religion Name Pools", "file_type": "concept", "source_file": "graphify-out/tex/Implementation_Plan.tex.md", "source_location": "Section: Data Files", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "graphify_out_tex_implementation_plan_tex_validation_results", "label": "Validation Results (13 Cypher Checks)", "file_type": "concept", "source_file": "graphify-out/tex/Implementation_Plan.tex.md", "source_location": "Subsection: Results", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Eleven of thirteen checks pass cleanly on 5,130,495 citizens; the two Notes are four out-of-window birth years and the sibling-gap tendency."}, {"id": "graphify_out_tex_implementation_plan_tex_sibling_gap_note", "label": "Sibling Gap Rule-3 Deviation", "file_type": "rationale", "source_file": "graphify-out/tex/Implementation_Plan.tex.md", "source_location": "Subsection: The Two Notes, Explained", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Child i gets birth year start + i*random(1..4) with an independent roll per child, so two children can land on the same year (read as twins) or more than 4 years apart. Rule 3 holds as a strong tendency (77.8%), not a guarantee; adding each gap to a running year instead of multiplying by the index would make it strict."}, {"id": "graphify_out_tex_implementation_plan_tex_birth_window_note", "label": "Four Wives Outside Birth Windows", "file_type": "rationale", "source_file": "graphify-out/tex/Implementation_Plan.tex.md", "source_location": "Subsection: The Two Notes, Explained", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "All four out-of-window people are injected wives born 1941-01-01, one year past the founder window - 0.00008% of the dataset, fixable by capping wife birth years at 1940 in the injection utility."}, {"id": "graphify_out_tex_implementation_plan_tex_why_synthetic_data", "label": "Why Synthetic Data", "file_type": "rationale", "source_file": "graphify-out/tex/Implementation_Plan.tex.md", "source_location": "Subsection: Why Synthetic Data", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Real NID data is legally confidential and a project like this should not try to obtain it, so the population is generated - which imposes the duty of proving both that the rules mirror the real country and that the data obeys the rules."}, {"id": "graphify_out_tex_implementation_plan_tex_debounced_search", "label": "300ms Debounced Search", "file_type": "rationale", "source_file": "graphify-out/tex/Implementation_Plan.tex.md", "source_location": "Section: Performance Considerations", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The search box waits 300ms after the last keystroke, otherwise every letter fires an API request."}, {"id": "graphify_out_tex_implementation_plan_tex_bounded_paths", "label": "Bounded 10-Level Traversal", "file_type": "rationale", "source_file": "graphify-out/tex/Implementation_Plan.tex.md", "source_location": "Section: Performance Considerations", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Ancestor and descendant queries stop at *1..10 so a traversal can never run away into the whole graph."}], "edges": [{"source": "graphify_out_tex_implementation_plan_tex_nid_data_create", "target": "graphify_out_tex_implementation_plan_tex_system_rules", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "graphify-out/tex/Implementation_Plan.tex.md", "source_location": "Section: Data Generation Module", "weight": 1.0}, {"source": "graphify_out_tex_implementation_plan_tex_nid_data_create", "target": "graphify_out_tex_implementation_plan_tex_polygyny_rules", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "graphify-out/tex/Implementation_Plan.tex.md", "source_location": "Subsection: Polygyny Selection Algorithm", "weight": 1.0}, {"source": "graphify_out_tex_implementation_plan_tex_nid_data_create", "target": "graphify_out_tex_implementation_plan_tex_districts_json", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "graphify-out/tex/Implementation_Plan.tex.md", "source_location": "Data Flow Pipeline Step 1", "weight": 1.0}, {"source": "graphify_out_tex_im