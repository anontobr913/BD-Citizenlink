{"nodes": [{"id": "graphify_out_tex_ieee_paper_tex_citizenlink", "label": "Citizenlink Graph-Based Registry Framework", "file_type": "paper", "source_file": "graphify-out/tex/IEEE_Paper.tex.md", "source_location": "Abstract", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Proposed because conventional record-oriented databases handle individual records well but cannot efficiently traverse multi-generational relationships, which blocks inheritance, lineage-verification, criminal-analysis and visa use cases."}, {"id": "graphify_out_tex_ieee_paper_tex_research_gap", "label": "Research Gap: Speed vs Legal Transparency", "file_type": "rationale", "source_file": "graphify-out/tex/IEEE_Paper.tex.md", "source_location": "Subsection: Problem Statement and Research Gap", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Static graph indexes must be recomputed on every birth and AI methods are accurate but opaque, while officials need transparent math to justify decisions; no existing system combines graph speed with legal transparency and real-time updates."}, {"id": "graphify_out_tex_ieee_paper_tex_index_free_adjacency", "label": "Index-Free Adjacency", "file_type": "rationale", "source_file": "graphify-out/tex/IEEE_Paper.tex.md", "source_location": "Subsection: Graph and Relational Architectures", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Each node stores on-disk pointers to its neighbors, so one hop costs O(1) at any depth, whereas traversing N recursion levels relationally needs N-1 joins and cost grows with every added level."}, {"id": "graphify_out_tex_ieee_paper_tex_pedigree_graphs", "label": "Pedigree Graphs and Traversal", "file_type": "rationale", "source_file": "graphify-out/tex/IEEE_Paper.tex.md", "source_location": "Subsection: Pedigree Graphs and Traversal", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Pedigrees are DAGs of individuals with parent-child edges; path-based indexes must be rebuilt whenever data changes and direction-optimizing BFS assumes a static distributed graph, both poor fits for a live registry."}, {"id": "graphify_out_tex_ieee_paper_tex_bidirectional_search", "label": "Bidirectional Search", "file_type": "rationale", "source_file": "graphify-out/tex/IEEE_Paper.tex.md", "source_location": "Subsection: Path Finding and Relationship Classification", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Searching from source and target at once cuts unidirectional O(b^d) to O(b^(d/2)); PBBA applies it to genealogy but assumes a symmetric graph, so it fits deep or disconnected branches poorly."}, {"id": "graphify_out_tex_ieee_paper_tex_semantic_kinship_layer", "label": "Semantic Kinship Constraint Layer", "file_type": "rationale", "source_file": "graphify-out/tex/IEEE_Paper.tex.md", "source_location": "Subsection: Path Finding and Relationship Classification", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A path alone does not name a relationship; a formal semantic layer above the edges can express non-traditional and multi-spouse topologies and separate biological, affinal and step relations. Existing rule engines are strictly Boolean, so one bad historical entry invalidates a valid branch."}, {"id": "graphify_out_tex_ieee_paper_tex_entity_resolution", "label": "Entity Resolution and Deduplication", "file_type": "rationale", "source_file": "graphify-out/tex/IEEE_Paper.tex.md", "source_location": "Subsection: Entity Resolution and Deduplication", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "String-similarity record linkage breaks on multi-part ethnonyms, name-order inversion and heterophonic transliteration; topology (shared neighbors, parent-child matches) distinguishes people better than attributes, but deep models leave no auditable trail and MCMC linkage does not scale nationally."}, {"id": "graphify_out_tex_ieee_paper_tex_synthetic_populations", "label": "Synthetic Populations and Temporal Auditing", "file_type": "rationale", "source_file": "graphify-out/tex/IEEE_Paper.tex.md", "source_location": "Subsection: Synthetic Populations and Temporal Auditing", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Random generators produce nonsense such as parents younger than their children, so microdata needs deterministic constraints; auditing follows the same logic, where one fixed contextual window such as 270 days catches offending records without scanning the whole graph."}, {"id": "graphify_out_tex_ieee_paper_tex_dataset_scale", "label": "Dataset Scale and Integrity Cross-Checks", "file_type": "concept", "source_file": "graphify-out/tex/IEEE_Paper.tex.md", "source_location": "Subsection: Dataset Scale", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "5,130,495 nodes and 10,161,934 relationships. Identical HAS_FATHER and HAS_MOTHER counts (4,347,936 each) prove no half-built record, and 782,559 parentless people match 782,500 founders plus 59 injected wives, proving no founder was lost in import."}, {"id": "graphify_out_tex_ieee_paper_tex_query_latency", "label": "Measured Query Response Times", "file_type": "concept", "source_file": "graphify-out/tex/IEEE_Paper.tex.md", "source_location": "Subsection: Query Response Times", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Median warm runs: 13.0ms NID search, 13.8ms profile, 22.6-37.6ms relationship by hop count, 44-90ms family tree, 2,894ms worst-case name search."}, {"id": "graphify_out_tex_ieee_paper_tex_answer_size_claim", "label": "Answer Size Matters More Than Database Size", "file_type": "rationale", "source_file": "graphify-out/tex/IEEE_Paper.tex.md", "source_location": "Subsection: Query Response Times", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every query starts at an indexed NID and walks only the nearby graph, never the whole population, so growing from 5M to 50M records would barely move the numbers - the thing a relational design cannot match."}, {"id": "graphify_out_tex_ieee_paper_tex_search_bottleneck", "label": "Name-Search Full-Scan Bottleneck", "file_type": "rationale", "source_file": "graphify-out/tex/IEEE_Paper.tex.md", "source_location": "Subsection: Search Behaviour", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "CONTAINS cannot use an index; 'hakim' returns in 25.6ms only by luck because LIMIT 20 fills early, while a no-match query must read all 5.13M names at ~2.9s. Worst case is 222x the best case and users reach it with a typo; the fix is a full-text index on full_name."}, {"id": "graphify_out_tex_ieee_paper_tex_hakim_sarker", "label": "Hakim Sarker Four-Wife Test Household", "file_type": "concept", "source_file": "graphify-out/tex/IEEE_Paper.tex.md", "source_location": "Section: Result Analysis", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "NID 1926209761584, a founder with four wives and 28 children, used throughout because he exercises the multiple-marriage features harder than an ordinary family."}, {"id": "graphify_out_tex_ieee_paper_tex_rokan_sarker", "label": "Rokan Sarker Polygamy Root Test", "file_type": "concept", "source_file": "graphify-out/tex/IEEE_Paper.tex.md", "source_location": "Subsection: Multiple Marriage Results", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "NID 1949207989002; rooting on a child is the only viewpoint that shows half-siblings and step-mothers at once. 6 full siblings, 21 half-siblings, 3 step-mothers and 1 mother, 54 people, no in-law labels - a fault at any layer would show as a wrong count."}, {"id": "graphify_out_tex_ieee_paper_tex_tree_gen_results", "label": "Family Tree Construction Results by Generation", "file_type": "concept", "source_file": "graphify-out/tex/IEEE_Paper.tex.md", "source_location": "Subsection: Family Tree Construction", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "All generations land between 44.0 and 48.3ms because the endpoint runs a fixed query set. Gen-3 is the worst case for the canvas: only 14 of 37 people are shown, since a Gen-3 person is the only one with full ancestry above and descendants below."}, {"id": "graphify_out_tex_ieee_paper_tex_audit_null_result", "label": "Birth Audit Zero-Flag Null Result", "file_type": "rationale", "source_file": "graphify-out/tex/IEEE_Paper.tex.md", "source_location": "Subsection: Birth Registration Audit Results", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Zero flags across 6,741 pairs is not a good result: siblings are spaced by whole years and every child shares a 15 June birthday, so gaps are either 0 or at least 365 days and can never land in the 1-269 day detection window. The audit logic is sound; the dataset simply cannot trigger it."}, {"id": "graphify_out_tex_ieee_paper_tex_connected_population", "label": "Population Becomes One Connected Web", "file_type": "rationale", "source_file": "graphify-out/tex/IEEE_Paper.tex.md", "source_location": "Subsection: Relationship Classification", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Two randomly picked unrelated founders were still linked at 19 hops (7 up, 5 marriages, 7 down) because marriages join separate family lines, so after four generations everyone is connected. This validates the 20-hop cap and shows far pairs fall back to a generic description."}, {"id": "graphify_out_tex_ieee_paper_tex_use_cases", "label": "Government Use Cases", "file_type": "concept", "source_file": "graphify-out/tex/IEEE_Paper.tex.md", "source_location": "Subsection: Motivation and Use Cases", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Birth registration auditing, immigration and visa verification, social welfare distribution, inheritance verification and criminal investigation via structural overlaps that expose aliases."}, {"id": "graphify_out_tex_ieee_paper_tex_limitations", "label": "Evaluation Limits and Future Work", "file_type": "rationale", "source_file": "graphify-out/tex/IEEE_Paper.tex.md", "source_location": "Section: Discussion and Conclusion", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Single machine so no network delay, medians of 5-10 runs so no confidence intervals, five hand-picked correctness pairs so no accuracy score, and the whole evaluation runs on data made by the project being tested. Remedies: full-text index on full_name, day-level birthdays, thousands of random test pairs, remote database host - none of which touch the schema or classifier."}, {"id": "graphify_out_tex_ieee_paper_tex_no_auth_limitation", "label": "No Authentication or Access Control", "file_type": "rationale", "source_file": "graphify-out/tex/IEEE_Paper.tex.md", "source_location": "Section: Discussion and Conclusion", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No authentication, session management or role-based access control, a serious privacy problem for a national database; the biological-parentage schema also cannot represent adoption, foster care or divorce."}, {"id": "graphify_out_tex_ieee_paper_tex_stanescu2021comparison", "label": "Stanescu (2021) Graph vs Relational Comparison", "file_type": "paper", "source_file": "graphify-out/tex/IEEE_Paper.tex.md", "source_location": "Related Work", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "graphify_out_tex_ieee_paper_tex_lupu2024concurrent", "label": "Lupu et al. (2024) Concurrent Neo4j Path Queries", "file_type": "paper", "source_file": "graphify-out/tex/IEEE_Paper.tex.md", "source_location": "Related Work", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "graphify_out_tex_ieee_paper_tex_kluge2023genealogical", "label": "Kluge (2023) Genealogical Inference", "file_type": "paper", "source_file": "graphify-out/tex/IEEE_Paper.tex.md", "source_location": "Related Work", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "graphify_out_tex_ieee_paper_tex_yang2012pathbased", "label": "Yang (2012) Path-Based Pedigree Index", "file_type": "paper", "source_file": "graphify-out/tex/IEEE_Paper.tex.md", "source_location": "Related Work", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "graphify_out_tex_ieee_paper_tex_buluc2017bfs", "label": "Buluc (2017) Direction-Optimizing BFS", "file_type": "paper", "source_file": "graphify-out/tex/IEEE_Paper.tex.md", "source_location": "Related Work", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "graphify_out_tex_ieee_paper_tex_pohl1971bidirectional", "label": "Pohl (1971) Bidirectional Search", "file_type": "paper", "source_file": "graphify-out/tex/IEEE_Paper.tex.md", "source_location": "Related Work", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "graphify_out_tex_ieee_paper_tex_nuanmeesri2009pbba", "label": "Nuanmeesri (2009) Parent Bidirectional Breadth Algorithm", "file_type": "paper", "source_file": "graphify-out/tex/IEEE_Paper.tex.md", "source_location": "Related Work", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "graphify_out_tex_ieee_paper_tex_meyer2019kinship", "label": "Meyer and Zimmermann (2019) Kinship Semantics", "file_type": "paper", "source_file": "graphify-out/tex/IEEE_Paper.tex.md", "source_location": "Related Work", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "graphify_out_tex_ieee_paper_tex_redavid2023semantic", "label": "Redavid (2023) Semantic Rule Engines", "file_type": "paper", "source_file": "graphify-out/tex/IEEE_Paper.tex.md", "source_location": "Related Work", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "graphify_out_tex_ieee_paper_tex_mudgal2018deep", "label": "Mudgal (2018) Deep Entity Matching", "file_type": "paper", "source_file": "graphify-out/tex/IEEE_Paper.tex.md", "source_location": "Related Work", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "graphify_out_tex_ieee_paper_tex_amirhosseini2024graph", "label": "Amirhosseini et al. (2024) Graph-Topology Entity Resolution", "file_type": "paper", "source_file": "graphify-out/tex/IEEE_Paper.tex.md", "source_location": "Related Work", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "graphify_out_tex_ieee_paper_tex_kou2015gdups", "label": "GDups (2015) Graph Duplicate Clustering", "file_type": "paper", "source_file": "graphify-out/tex/IEEE_Paper.tex.md", "source_location": "Related Work", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "graphify_out_tex_ieee_paper_tex_steorts2018bayesian", "label": "Steorts (2018) Bayesian Record Linkage", "file_type": "paper", "source_file": "graphify-out/tex/IEEE_Paper.tex.md", "source_location": "Related Work", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "graphify_out_tex_ieee_paper_tex_kirkpatrick2010pedigree", "label": "Kirkpatrick (2010) Combinatorial Pedigree Reconstruction", "file_type": "paper", "source_file": "graphify-out/tex/IEEE_Paper.tex.md", "source_location": "Related Work", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "graphify_out_tex_ieee_paper_tex_muller2011hierarchical", "label": "Muller and Axhausen (20